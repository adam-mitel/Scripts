; Coded For: 6.0.0.0
; Script Version: 50.0.1.0
; ************************************************************************
;
;  This is the HI configuration script for interfacing to a PMS emulating
;  a Boche BCS using ACOM messages.
;
;                                                              AU-20240417
;
; ************************************************************************
;                     Copyright © 2024, TigerTMS Ltd.                     
; ************************************************************************
;
define ReceivedRec
define RecType
define SendRec
define WorkVal
;
define Date
define Time
;
define in_BCC
define in_COS
define in_Data
define in_Date
define in_Language
define in_Name
define in_Room
define in_Status
define in_Time
;
; ************************************************************************
;  INIT
;   This label is called at program startup.
:INIT

	OpenPort

Goto PORT_OPENED
; ************************************************************************


; ************************************************************************
;  PORT_OPENED
;    This label is called when an IP Connection is established.
:PORT_OPENED

	Call GetDateTime
	Assign SendRec "<#2>00TKEIN<Date:TEXT:8:RJ,SP><Time:TEXT:6:RJ,SP><#3>"
	Call SendRecord

Exit
; ************************************************************************


; ************************************************************************
;  SHUTDOWN
;    This label is called when the program is terminated.
:SHUTDOWN

	Call GetDateTime
	Assign SendRec "<#2>00TKAUS<Date:TEXT:8:RJ,SP><Time:TEXT:6:RJ,SP><#3>"
	Call SendRecord

Exit
; ************************************************************************


; ************************************************************************
:CallRecord

	Echo If: Guest Call Record Info - Room: $(_EV_ROOMNUMBER) - Date: <_EV_CALLDATE:DATE:6:YYMMDD> - Time: <_EV_CALLTIME:TIME:6:HHMMSS> - ID: $(_EV_ID) - Charge: $(_EV_CALLCHARGEPENCE)
	Call GetDateTime
	Assign SendRec "<#2>00TKGDV<_EV_ROOMNUMBER:TEXT:5:RJ,ZP><_EV_CALLDATE:DATE:8:YYYYMMDD><_EV_CALLTIME:TIME:6:HHMMSS><_EV_CALLDIALLEDDIGITS:TEXT:15:LJ,SP>001 <_EV_CALLCHARGEPENCE:TEXT:4:RJ,ZP><#3>"
	Call SendRecord

Goto HandleOKAndExit
; ************************************************************************


; ************************************************************************
;  RoomStatus
;   This label is executed by the program when we have a Room Status
;   event to send.
:RoomStatus

	Call GetDateTime
	Assign SendRec "<#2>00TKRST<_EV_ROOMNUMBER:TEXT:5:RJ,ZP><Date:TEXT:8:RJ,SP><Time:TEXT:6:RJ,SP><_EV_RSCODE:TEXT:5:RJ,ZP><#3>"
	Call SendRecord

Goto HandleOKAndExit
; ************************************************************************


; ************************************************************************
;  Minibar
;   This label is executed by the program when we have a Minibar Event
;   to send.
:Minibar

Goto IgnoreRecord
; ************************************************************************


; ************************************************************************
;  MessageWaiting
;   This label is executed by the program when we have a Message Waiting
;   event to send.
:MessageWaiting

Goto IgnoreRecord
; ************************************************************************


; ************************************************************************
