; ************************************************************************


; ************************************************************************
;  PeriodicCheck
;   This label is executed periodically by the program.
:PeriodicCheck

Exit
; ************************************************************************


; ************************************************************************
;  CheckIncoming
;   This label is executed by the program periodically to check incoming
;   messeges.
:CheckIncoming

	ReadFromPort 1
	
	if "$(_PORTCHARS)" EQ "<#13>"
		Exit
	if "$(_PORTCHARS)" EQ "<#10>"
		Exit

	if "$(_PORTCHARS)" EQ "<#2>"
		Assign ReceivedRec <#2>
	if "$(_PORTCHARS)" EQ "<#2>"
		Goto ReceiveRecord

	if "$(_PORTCHARS)" NE ""
		Echo Rx: $(_PORTCHARS)

	if "$(_PORTCHARS)" EQ "<#5>"
		Call SendACK

Exit
; ************************************************************************


; ************************************************************************
;  ReceiveRecord
;   This label is called when we have received an STX within the
;   CheckIncoming or SendRecord labels.
:ReceiveRecord

	Assign in_BCC ""
	Assign in_Data ""
	Assign in_Room ""
	Assign in_Status ""

	ReadFromPort 1 1

	if "$(_PORTCHARS)" NE ""
		Assign ReceivedRec "$(ReceivedRec)$(_PORTCHARS)"

	if "$(_PORTCHARS)" EQ "<#3>"
		Goto ReceiveRecord_Finished
	if "$(_PORTCHARS)" EQ "<#13>"
		Goto ReceiveRecord_Finished

	Goto ReceiveRecord

:ReceiveRecord_Finished

	Echo Rx: $(ReceivedRec)

	if "<ReceivedRec:TEXT:8:LJ,SP>" EQ "<#2>00TKMES"
		Call HandleMessageWaiting
	if "<ReceivedRec:TEXT:8:LJ,SP>" EQ "<#2>00  MES"
		Call HandleMessageWaiting
	if "<ReceivedRec:TEXT:8:LJ,SP>" EQ "<#2>00TKBUM"
		Call HandleCheckinOut
	if "<ReceivedRec:TEXT:8:LJ,SP>" EQ "<#2>00  BUM"
		Call HandleCheckinOut
	if "<ReceivedRec:TEXT:8:LJ,SP>" EQ "<#2>00TKWEK"
		Call HandleWakeup
	if "<ReceivedRec:TEXT:8:LJ,SP>" EQ "<#2>00  WEK"
		Call HandleWakeup

	Call SendACK

Exit
; ************************************************************************


; ************************************************************************
;  ParseRecord
;   This label is called when we need to parse an incoming record
:ParseRecord

	Assign _G_IN_RECORD "$(ReceivedRec)"
	ParseInRecord

Return
; ************************************************************************


; ************************************************************************
;  HandleMessageWaiting
;	Handle a Message Waiting Message.
:HandleMessageWaiting

	AssignAsIs _G_IN_RECORDFORMAT "<#2>00  MES<in_Room:TEXT:5:RJ,ZP><in_Date:TEXT:8:RJ,SP><in_Time:TEXT:6:RJ,SP><in_Status:NUMBER:2:RJ,ZP><#3>"

	Call ParseRecord

	if "$(_G_IN_RECORDPARSEERROR)" EQ "TRUE"
		Echo Er: Problem parsing Message Waiting Record
	if "$(_G_IN_RECORDPARSEERROR)" EQ "TRUE"
		Return

	Assign WorkVal "FALSE"
	if "$(in_Status)" EQ "01"
		Assign WorkVal "TRUE"

	CreateMessageWaiting "$(in_Room)" "$(WorkVal)"

Return
; ************************************************************************


; ************************************************************************
;  HandleCheckinOut
;	Handle a Checkin or Checkout Message.
:HandleCheckinOut

	AssignAsIs _G_IN_RECORDFORMAT "<#2>00  BUM<in_Room:TEXT:5:RJ,ZP><in_Date:TEXT:8:RJ,SP><in_Time:TEXT:6:RJ,SP><in_Language:NUMBER:1:SP>1<in_Name:TEXT:16:LJ,SP,AN><in_COS:TEXT:1:RJ,SP><#3>"

	Call ParseRecord

	if "$(_G_IN_RECORDPARSEERROR)" EQ "TRUE"
		Echo Er: Problem parsing Checkin/out Record
	if "$(_G_IN_RECORDPARSEERROR)" EQ "TRUE"
		Return

	if "$(in_Name)" EQ ""
		CreateCheckOut "$(in_Room)" "" "" "$(in_Language)"
	if "$(in_Name)" NE ""
		CreateCheckIn "$(in_Room)" "" "" "$(in_Language)" "$(in_Name)" "" "" "" "FALSE"

	Assign WorkVal "FALSE"
	if "$(in_COS)" EQ "1"
		Assign WorkVal "TRUE"

	CreateCOS "$(in_Room)" "$(in_Reservation)" "TRUE" "$(WorkVal)" "TRUE" "TRUE" ""

Return
; ************************************************************************


; ************************************************************************
;  HandleWakeup
;	Handle a Wakeup Message.
:HandleWakeup

	AssignAsIs _G_IN_RECORDFORMAT "<#2>00  WEK<in_Room:TEXT:5:RJ,ZP><in_Date:DATE:8:YYYYMMDD><in_Time:TIME:6:HHMMSS><in_Data:NUMBER:2:RJ,ZP><in_Status:NUMBER:1:RJ,SP><#3>"

	Call ParseRecord

	if "$(_G_IN_RECORDPARSEERROR)" EQ "TRUE"
		Echo Er: Problem parsing Wakeup Record
	if "$(_G_IN_RECORDPARSEERROR)" EQ "TRUE"
		Return

	if "$(in_Status)" EQ "1"
		CreateSetWakeup "$(in_Room)" "" "<in_Time:TIME:4:HHMM>" "<in_Date:DATE:8:YYYYMMDD>"
	if "$(in_Status)" EQ "3"
		CreateClearAllWakeup "$(in_Room)" ""

Return
; ************************************************************************


; ************************************************************************
;  SendRecord
;   This label is called when we have a record that we need to send to the
;   client.
:SendRecord

goto SendRecord_GotACKToENQ

	StartWaitTimer 3

	Send <#5>
	Echo Tx: <#5>

:SendRecord_WaitForACKToENQ

	ReadFromPort 1 2

	if "$(_WAITTIMEEXPIRED)" EQ "TRUE"
		Echo Er: Timeout waiting for ACK
	if "$(_WAITTIMEEXPIRED)" EQ "TRUE"
		Exit

	if "$(_PORTCHARS)" EQ ""
		Goto SendRecord_WaitForACKToENQ

	if "$(_PORTCHARS)" EQ "<#2>"
		Assign ReceivedRec "<#2>"
	if "$(_PORTCHARS)" EQ "<#2>"
		Goto ReceiveRecord

	if "$(_PORTCHARS)" EQ "<#5>"
		Echo Rx: $(_PORTCHARS)
	if "$(_PORTCHARS)" EQ "<#5>"
		Call SendACK

	if "$(_PORTCHARS)" EQ "<#6>"
		Echo Rx: $(_PORTCHARS)
	if "$(_PORTCHARS)" EQ "<#6>"
		Goto SendRecord_GotACKToENQ

	if "$(_PORTCHARS)" EQ "<#21>"
		Echo Rx: $(_PORTCHARS)
	if "$(_PORTCHARS)" EQ "<#21>"
		Exit

	Goto SendRecord_WaitForACKToENQ

:SendRecord_GotACKToENQ

	Send $(SendRec)
	Echo Tx: $(SendRec)

	StartWaitTimer 3

:SendRecord_WaitForACKToRec

	ReadFromPort 1 2

	if "$(_WAITTIMEEXPIRED)" EQ "TRUE"
		Echo Er: Timeout waiting for ACK
	if "$(_WAITTIMEEXPIRED)" EQ "TRUE"
		Exit

	if "$(_PORTCHARS)" EQ ""
		Goto SendRecord_WaitForACKToRec

	if "$(_PORTCHARS)" EQ "<#2>"
		Assign ReceivedRec "<#2>"
	if "$(_PORTCHARS)" EQ "<#2>"
		Goto ReceiveRecord

	if "$(_PORTCHARS)" EQ "<#5>"
		Echo Rx: $(_PORTCHARS)
	if "$(_PORTCHARS)" EQ "<#5>"
		Call SendACK

	if "$(_PORTCHARS)" EQ "<#6>"
		Echo Rx: $(_PORTCHARS)
	if "$(_PORTCHARS)" EQ "<#6>"
		Goto SendRecord_GotACKToRec

	if "$(_PORTCHARS)" EQ "<#21>"
		Echo Rx: $(_PORTCHARS)
	if "$(_PORTCHARS)" EQ "<#21>"
		Exit

	Goto SendRecord_WaitForACKToRec

:SendRecord_GotACKToRec

Return
; ************************************************************************


; ************************************************************************
;  GetDateTime
;	Sets up the Date and Time variables with the current date and time.
:GetDateTime

	Assign Date "<_G_NOW:DATE:8:YYYYMMDD>"
	Assign Time "<_G_NOW:TIME:6:HHMMSS>"

Return
; ************************************************************************


; ************************************************************************
; SendACK
;    This label is called when we need to send an ACK.
:SendACK

	Echo Tx: <#6>
	Send <#6>

Return
; ************************************************************************


; ************************************************************************
;  HandleOKAndExit
;   This label is called when we have completed sending a record and need
;   to flag it as processed to move on to the next event.
:HandleOKAndExit

	FlagProcessed OK

Exit
; ************************************************************************


; ************************************************************************
;  IgnoreRecord
;   This label is called when we are not interested in a particular record
;   and need to flag it as processed to move on to the next event.
:IgnoreRecord

	FlagProcessed OK

Exit
; ************************************************************************